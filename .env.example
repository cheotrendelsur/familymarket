# Copia este archivo a .env.local y completa los valores (Supabase → Project Settings → API).
# La anon key es pública por diseño (viaja dentro del JavaScript de la app); la seguridad real
# está en las políticas RLS y en las funciones RPC (ver supabase/migrations).
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key
